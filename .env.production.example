# Copy to .env.production on your machine; deploy.sh sends it to the server. Keypairs go in secrets/, not here.

CLUSTER=mainnet
# Caddy gets certificates for SITE_HOST and www.SITE_HOST once their A records point at the instance.
# Before DNS is pointed, use the Elastic IP with dashes, e.g. SITE_HOST=3-80-12-34.sslip.io and SITE_URL=https://3-80-12-34.sslip.io
SITE_HOST=quants.wtf
SITE_URL=https://quants.wtf
TRUST_PROXY=1

# Hex only (openssl rand -hex 24): it is put into DATABASE_URL unescaped
POSTGRES_USER=quants
POSTGRES_PASSWORD=
POSTGRES_DB=quants

# Keyed RPC for the server. The browser sees NEXT_PUBLIC_RPC_URL, so use a domain-restricted key there.
RPC_URL=
# Optional second provider for the indexer only; falls back to RPC_URL
INDEXER_RPC_URL=
NEXT_PUBLIC_RPC_URL=
JUPITER_API_KEY=

TREASURY_ADDRESS=
# Public addresses only, shown on the admin Wallets tab: the line printed by bun scripts/hd-wallet.ts env
PLATFORM_ADDRESSES=
KEEPER_ADDRESS=
SPILL_ADDRESS=
KAMINO_GLOBAL_CONFIG=
DAMM_V2_MIGRATION_CONFIG=A8gMrEPJkacWkcb3DGwtJwTe16HktSEfvwtuDh2MCtck
# Contents of config-keys.json from scripts/create-configs.ts, on one line
CONFIG_KEYS=
# Leave empty on mainnet; the real USDC, USDT and JUP mints are built in
QUOTE_MINTS=

CLOUDINARY_URL=
# From bun scripts/admin-code.ts: the plain code stays in ~/.config/quants/mainnet/admin-code.txt, only the hash goes here
ADMIN_CODE_HASH=
# openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Fallback for the X link when the admin setting is empty. Built into the bundle.
NEXT_PUBLIC_X_URL=https://x.com/launchonquants

# Seed values only: read once, when a fresh database gets its first settings version. After that the admin page owns them.
# Platform token mint (empty until it launches), symbol, decimals and whole units raised at graduation
OURTOKEN_MINT=
OURTOKEN_SYMBOL=QUANTS
OURTOKEN_DECIMALS=6
OURTOKEN_GRADUATION=
# Graduation targets by pair symbol, e.g. {"SOL":100,"USDC":15000}
QUOTE_GRADUATIONS=
# 1 turns stock pairs on
STOCK_PAIRS=
ALERT_WEBHOOK_URL=

# Backups: daily pg_dump to ./backups, kept BACKUP_RETENTION_DAYS days. S3 upload only when BACKUP_S3_URI is set.
BACKUP_HOUR_UTC=3
BACKUP_RETENTION_DAYS=7
BACKUP_S3_URI=
# Only needed for S3 when the instance has no IAM role that can write to the bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
