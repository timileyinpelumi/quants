[Unit]
Description=quants web
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
WorkingDirectory=/opt/quants
EnvironmentFile=/opt/quants/web.env
ExecStart=/usr/local/bin/bun --bun next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=5
User=quants

[Install]
WantedBy=multi-user.target
